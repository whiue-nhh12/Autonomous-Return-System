    classDef logic fill:#eee8ff,stroke:#7656a6,color:#30214b
    classDef review fill:#fff3cd,stroke:#ba8b00,color:#493600
    classDef result fill:#e5f4e8,stroke:#34804b,color:#183d24
    class IN,FIELDS input
    class PARSE,GRAPH,AGENT,HAS_EVIDENCE,PROVIDER,CONFIGURED,NO_RULES,RULESET,EVAL,ORDER,ITEM,QTY,POLICY,DIMENSIONS,AGGREGATE logic
    class REVIEW,CLARIFY review
    class OUTCOME result
