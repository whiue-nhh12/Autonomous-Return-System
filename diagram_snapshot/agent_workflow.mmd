flowchart TD
    USER["Người dùng gửi một lượt mới<br/>message + conversation_id"] --> INVOKE["ManagerAgentGraph.invoke<br/>request_id mới, state mới"]
    INVOKE --> STORE{"Có conversation_id?"}
    STORE -->|Có| LOAD["Lấy context đang chờ làm rõ<br/>theo user_id + conversation_id<br/>khóa lượt xử lý cùng hội thoại"]
    STORE -->|Không| EMPTY["Context hội thoại rỗng"]
    LOAD --> INIT["Tạo AgentSharedState<br/>prior_messages + pending_intent + claim"]
    EMPTY --> INIT

    INIT --> VALIDATE["validate_request<br/>kiểm tra và chuẩn hóa input"]
    VALIDATE --> CLASSIFY["classify_intent + trích xuất return claim"]
    CLASSIFY --> RULES["1. Luật từ khóa xác định intent rõ"]
    RULES --> CLEAR{"Intent đã rõ?"}
    CLEAR -->|Rồi| EXTRACT["Nếu là order/return intent:<br/>trích xuất claim bằng luật<br/>có thể dùng LLM bổ sung trường còn thiếu"]
    CLEAR -->|Chưa| REPLY{"Có phải câu trả lời ngắn<br/>cho câu hỏi làm rõ trước đó?"}
    REPLY -->|Có| CONTINUE["Dùng intent đang chờ<br/>hoặc intent từ lựa chọn rõ ràng"]
    REPLY -->|Không| LLM{"Đã cấu hình LLM?"}
    LLM -->|Có| PREDICT["LLM trả JSON có cấu trúc"]
    PREDICT --> CONF{"JSON hợp lệ<br/>và confidence đạt ngưỡng?"}
    CONF -->|Có| EXTRACT
    CONF -->|Không| UNCLEAR["intent = unclear"]
    LLM -->|Không| UNCLEAR
    CONTINUE --> EXTRACT

    EXTRACT --> ROUTE{"route_intent"}
    UNCLEAR --> CLARIFY["Hỏi người dùng làm rõ intent"]

    ROUTE -->|policy_question| POLICY["Policy worker<br/>tìm bằng chứng chính sách"]
    ROUTE -->|order_status| ORDER["Order worker<br/>tra cứu đơn theo user_id"]
    ROUTE -->|return_eligibility| FANOUT["Chạy song song hai worker"]
    ROUTE -->|submit_return| SUBMIT["Submit-return placeholder<br/>hiện trả not_configured"]

    FANOUT --> EP["Policy worker<br/>bằng chứng chính sách"]
    FANOUT --> EO["Order worker<br/>đơn hàng và sản phẩm"]
    EP --> DECIDE["Return decision worker<br/>kết hợp claim + đơn + policy<br/>claim do LLM bổ sung → manual_review<br/>thiếu rule/evidence → manual_review"]
    EO --> DECIDE

    POLICY --> FINAL["finalize_response<br/>gom kết quả, trạng thái, câu trả lời"]
    ORDER --> FINAL
    SUBMIT --> FINAL
    DECIDE --> FINAL
    CLARIFY --> FINAL

    FINAL --> WAIT{"clarification.awaiting_user?"}
    WAIT -->|Có, có conversation_id| SAVE["Lưu tối đa 8 tin nhắn + intent + claim<br/>TTL 30 phút, scope theo user + conversation"]
    WAIT -->|Không, hoặc không có conversation_id| DELETE["Xóa context hội thoại đã lưu<br/>nếu có conversation_id"]
    SAVE --> RESPONSE["Trả AgentSharedState / ManagerResponse"]
    DELETE --> RESPONSE
    RESPONSE --> NEXT["Lượt sau dùng cùng conversation_id<br/>để tiếp tục nếu đang chờ làm rõ"]
    NEXT -. "request mới, request_id mới" .-> INVOKE

